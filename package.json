{
  "name": "abretela",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-web.mjs && node scripts/build-server.mjs && vite",
    "build": "node scripts/build-web.mjs && node scripts/build-server.mjs && vite build",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json",
    "check": "npx --yes -p typescript@6 -p svelte-check@4.7.8 svelte-check --threshold warning",
    "test": "vitest run",
    "tauri": "tauri",
    "fetch-cloudflared": "node scripts/fetch-cloudflared.mjs",
    "release:patch": "npm version patch -m \"v%s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"v%s\" && git push --follow-tags"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "esbuild": "0.28.2",
    "svelte": "^5.57.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "4.158.0"
  }
}
