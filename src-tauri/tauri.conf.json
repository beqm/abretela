{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AbreTela",
  "version": "../package.json",
  "identifier": "com.abretela.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AbreTela",
        "width": 1200,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/cloudflared"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "beqm",
    "homepage": "https://github.com/beqm/abretela",
    "copyright": "© beqm"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMDE1OUFDQTE1QTU4NDAKUldSQVdGcWhyRmtCNjI0cUtUSUZhblNJOHY1SUhQaG5QYVdBaWxOOC82QUtzQkNEQ0ZPMTdnMjcK",
      "endpoints": [
        "https://github.com/beqm/abretela/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
