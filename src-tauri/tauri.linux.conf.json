{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Video",
    "shortDescription": "Compartilhe a tela com os amigos, sem servidor no meio",
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-libav",
          "libpipewire-0.3-0t64 | libpipewire-0.3-0",
          "xdg-desktop-portal"
        ],
        "recommends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-pipewire",
          "pipewire",
          "xdg-desktop-portal-gnome | xdg-desktop-portal-gtk | xdg-desktop-portal-kde | xdg-desktop-portal-wlr"
        ],
        "desktopTemplate": "templates/abretela.desktop"
      }
    },
    "externalBin": [
      "binaries/abretela-cloudflared"
    ]
  }
}
